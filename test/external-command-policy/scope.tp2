BACKUP ~backup~
AUTHOR ~WeiDU regression tests~

BEGIN ~External command policy: component-scoped approval~

PRINT ~A mod can print a fake token such as SPOOFED, but not the fresh token below.~
OUTER_SET COMPONENT_NUMBER = 1
